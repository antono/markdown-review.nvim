{
  "compileOnSave": true,
  "compilerOptions": {
    "resolveJsonModule": true,
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "dom",
      "esnext"
    ],
    "baseUrl": ".",
    "outDir": "./app/lib",
    "rootDir": "./src",
    "importHelpers": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "./src"
  ],
  "exclude": [
    "./lib",
    "node_modules"
  ]
}
