#!/usr/bin/env bash
# Wrapper to test markdown-review plugin with Neovim
# Usage: nvim-test [file] [nvim-args...]

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Create a temporary init file
INIT_FILE=$(mktemp --suffix=.vim)
trap "rm -f $INIT_FILE" EXIT

cat > "$INIT_FILE" << 'EOF'
set runtimepath+=PLUGIN_PATH
filetype plugin indent on
EOF

# Replace placeholder with actual plugin path
sed -i "s|PLUGIN_PATH|$PLUGIN_DIR|g" "$INIT_FILE"

# Use first argument as file if provided, otherwise default to README.md
FILE="${1:-.}"
if [[ -z "$1" ]]; then
  FILE="README.md"
  shift || true
else
  shift || true
fi

# Run nvim with the plugin loaded
exec nvim -u "$INIT_FILE" "$FILE" "$@"
