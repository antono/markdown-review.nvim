{
  "name": "markdown-review",
  "version": "0.0.10",
  "description": "markdown preview with review comments for (neo)vim",
  "bin": "./app/server.js",
  "repository": "https://github.com/iamcco/markdown-preview.nvim.git",
  "author": "年糕小豆汤 <ooiss@qq.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "watch": "tsc -w -p ./",
    "build-app": "cd app && rm -rf ./.next && next build && next export",
    "build-lib": "tsc -p ./",
    "build": "tsc -p ./ && cd app && rm -rf ./.next && next build && next export && yarn && pkg --targets node16-linux-x64,node16-macos-x64,node16-win-x64 --out-path ./bin . && rm -rf ./node_modules ./.next"
  },
  "dependencies": {
    "@chemzqm/neovim": "^5.7.9",
    "chart.js": "^4.4.1",
    "highlight.js": "^11.9.0",
    "log4js": "^6.10.2",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^8.6.7",
    "markdown-it-deflist": "^2.0.3",
    "markdown-it-emoji": "^2.0.0",
    "markdown-it-footnote": "^3.0.1",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-toc-done-right": "^4.2.0",
    "md-it-meta": "^0.0.2",
    "msgpack-lite": "^0.1.26",
    "next": "^14.1.0",
    "next-routes": "^1.4.2",
    "plantuml-encoder": "^1.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "pkg": "^5.8.1",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "eslint": "^8.56.0"
  }
}
